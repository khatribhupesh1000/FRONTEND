// DIFFERENCE BETWEEN == AND ===
// == check the elements are same without checking the type of elements
//          if string is compared with number then string is convert into number

let a="10";
let b=10;
console.log(a==b);
// but what will happen when === -> first check type of elements
//                               -> second check the elements are equal
console.log(a===b);

// what will happen
let c="123ab";
let d=Number(c);
console.log(d);// NaN-> not a number

console.log(0/0);// NaN

console.log(typeof(d));// type of NaN-> number

// number to string
let e=10;
let f=String(e);
console.log(typeof(f));

// boolean-> number
let g=true;
let h=Number(g);
console.log(typeof(h));

// convertion of null -> 0 and undefined ->NaN
console.log(Number(null));
