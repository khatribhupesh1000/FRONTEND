// INCONSISTENCY WITH DATE OBJECTS
// when we create a date object with new Date() it will return the current date and time in the local timezone
// but when we create a date object with new Date('2024-06-18') it will return the date in the UTC timezone
// so we have to be careful while creating date objects with different formats
// 
// month is 0 based index so jan=0,feb=1,mar=2,apr=3,may=4,jun=5,jul=6,aug=7,sep=8,oct=9,nov=10,dec=11
const date2=new Date(2024,5,18);// it will return the date in the local timezone
console.log(date2);

// to get the year we can use getFullYear() method
console.log(date2.getFullYear());// it will return the year

// to get the month we can use getMonth() method
console.log(date2.getMonth());// it will return the month

// to get the date we can use getDate() method
console.log(date2.getDate());// it will return the date

// to get the day we can use getDay() method
console.log(date2.getDay());// it will return the day

// to get the hours we can use getHours() method
console.log(date2.getHours());// it will return the hours

// to get the minutes we can use getMinutes() method
console.log(date2.getMinutes());// it will return the minutes

// to get the seconds we can use getSeconds() method
console.log(date2.getSeconds());// it will return the seconds

// to get the milliseconds we can use getMilliseconds() method
console.log(date2.getMilliseconds());// it will return the milliseconds

// to get the time in milliseconds we can use getTime() method
console.log(date2.getTime());// it will return the time in milliseconds

// to get the timezone offset we can use getTimezoneOffset() method
console.log(date2.getTimezoneOffset());// it will return the timezone offset in minutes

// to set the year we can use setFullYear() method
date2.setFullYear(2025);// it will set the year
console.log(date2);

// to set the month we can use setMonth() method
date2.setMonth(6);// it will set the month
console.log(date2);

// to set the date we can use setDate() method
date2.setDate(19);// it will set the date
console.log(date2);

// to set the hours we can use setHours() method
date2.setHours(10);// it will set the hours
console.log(date2);

// to set the minutes we can use setMinutes() method
date2.setMinutes(30);// it will set the minutes
console.log(date2);

// to set the seconds we can use setSeconds() method
date2.setSeconds(45);// it will set the seconds
console.log(date2);

// to set the milliseconds we can use setMilliseconds() method
date2.setMilliseconds(500);// it will set the milliseconds
console.log(date2);

// to set the time in milliseconds we can use setTime() method
date2.setTime(1687104000000);// it will set the time in milliseconds
console.log(date2);


