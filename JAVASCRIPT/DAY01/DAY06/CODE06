//----------------STRING--------------------//
const str1="bkk";
const str2='bkk';
const day=18;
const str3=`Strink is coming one day 
${day}`;// we can use this like this that is why it is modern way of writing string
console.log(str1,str2,str3);

// if we want the length of string-> as length is the property of string so we can use it like this
console.log(str3.length);

// toUpperCase() and toLowerCase()-> in these a new string is returned and the original string is not changed
console.log(str3.toUpperCase());
console.log(str3.toLowerCase());

// to find the particular index of the string we can use indexOf() and lastIndexOf() method
console.log(str3.indexOf('Strink'));// it will return the index of first character of the string
console.log(str3.lastIndexOf('Strink'));// it will return the index of first character of the string from last

// to find the particular character at particular index we can use charAt() method
console.log(str3.charAt(0));// it will return the character at 0th index

// to find the particular character at particular index we can use [] operator
console.log(str3[0]);// it will return the character at 0th index

// to find the substring from a string we can use substring() method
console.log(str3.substring(0,6));// it will return the substring from 0 to 6-1=5 index

// to find the substring from a string we can use slice() method
console.log(str3.slice(0,6));// it will return the substring from 0 to 6-1=5 index

// to find the substring from a string we can use substr() method
console.log(str3.substr(0,6));// it will return the substring from 0 to 6-1=5 index

// to replace the substring from a string we can use replace() method
console.log(str3.replace('Strink','String'));// it will return the string with replaced substring

// to check whether the string starts with a particular substring or not we can use startsWith() method
console.log(str3.startsWith('Strink'));// it will return true if the string starts with the substring else false

// to check whether the string ends with a particular substring or not we can use endsWith() method
console.log(str3.endsWith('day'));// it will return true if the string ends with the substring else false

// to check whether the string includes a particular substring or not we can use includes() method
console.log(str3.includes('one'));// it will return true if the string includes the substring else false

// to trim the string we can use trim() method
const str4='   bkk   ';
console.log(str4.trim());// it will return the string without leading and trailing spaces

// to split the string we can use split() method
const str5='bkk is a good place';
console.log(str5.split(' '));// it will return an array of substrings split by the space

// to get the character code of a particular character we can use charCodeAt() method
console.log(str5.charCodeAt(0));// it will return the character code of the character at 0th index

// to get the string from character code we can use fromCharCode() method
