// ------------ ARRAY----------------------
let arr = [1, 2, 3, 4, 5];
// to get the length of the array we can use length property
console.log(arr.length);// it will return the length of the array

console.log(typeof(arr));// it will return object because array is an object in javascript

arr[0]="bkk";
console.log(arr);// so array is mutable because we can change the value of the array at any index

arr.push(6);// it will add the value at the end of the array
console.log(arr);

arr.pop();// it will remove the last value of the array
console.log(arr);

arr.unshift(0);// it will add the value at the start of the array
console.log(arr);

arr.shift();// it will remove the first value of the array
console.log(arr);

// to get the index of a particular value in the array we can use indexOf() method
console.log(arr.indexOf(3));// it will return the index of the value 3 in the array

// to check whether a particular value is present in the array or not we can use includes() method
console.log(arr.includes(3));// it will return true if the value is present in the array otherwise false

// to get a new array with values greater than 3 we can use filter() method
let newArr = arr.filter(function(value){
    return value>3;
});
console.log(newArr);// it will return a new array with values greater than 3


let arr1=[1,2,3,4,5];
for(let i=0;i<arr1.length;i++){
    console.log(arr1[i]);// it will return the value at the index i of the array
}

// to get the sum of all values in the array we can use reduce() method
let sum = arr1.reduce(function(accumulator,currentValue){
    return accumulator+currentValue;
},0);
console.log(sum);// it will return the sum of all values in the array

// to get a new array with values multiplied by 2 we can use map() method
let newArr1 = arr1.map(function(value){
    return value*2;
});
console.log(newArr1);// it will return a new array with values multiplied by 2


// for of loop
for(let value of arr1){
    console.log(value);// it will return the value of the array
}

const a1=[1,2,3,4,5];
const a2=a1.slice(1,4);
console.log(a1,a2);// it will return a new array with values from index 1 to 4-1=3 of the original array

// but if we want to trim in the original array then use splice
const b1=[1,2,3,4,5];
const b2=b1.splice(1,3);// it will remove the values from index 1 to 3 of the original array and return a new array with those values
console.log(b1,b2);// it will return the original array with values removed and a new array with those values

//  spread operator
const c1=[1,2,3,4,5];
const c2=[6,7,8,9,10];
const c3=[...c1,...c2];// it will return a new array with values of both arrays
console.log(c3);

// to get the maximum value in the array we can use Math.max() method with spread operator
console.log(Math.max(...c3));// it will return the maximum value in the array

// to get the minimum value in the array we can use Math.min() method with spread operator
console.log(Math.min(...c3));// it will return the minimum value in the array

// to sort the array in ascending order we can use sort() method
const d1=[101,90,80,70,60];
d1.sort();
console.log(d1);// it will return the array in ascending order
// but [ 101, 60, 70, 80, 90 ] is not in ascending order
// as sort() function consider the elemets of it as the character

const d2=[101,90,80,70,60];
d2.sort((a,b)=>a-b);// it will return the array in ascending order
console.log(d2);// it will return the array in ascending order

// to sort the array in descending order we can use sort() method
const d3=[101,90,80,70,60];
d3.sort((a,b)=>b-a);// it will return the array in descending order
console.log(d3);// it will return the array in descending order

const d4=[101,90,[80,[70,60],50],40,30];
const d5=d4.flat(2);// it will return a new array with all sub-array elements concatenated into it recursively up to the specified depth
console.log(d5);// it will return a new array with all sub-array elements concatenated into it recursively up to the specified depth

console.log(d4);
d4.name="bkk";// it will add a new property to the array
console.log(d4);
