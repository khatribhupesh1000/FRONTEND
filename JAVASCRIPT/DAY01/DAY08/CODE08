// ---------------INDEPENDENT OBJECTS-----------------
const obj4={...obj3};// it will return the object with all properties of obj3
obj4.name="bkk";
console.log(obj4);// it will return the object with all properties of obj3
console.log(obj3);// it will return the object with all properties of obj3

// BUT THIS WILL NOT WORK IF THE OBJECT HAS NESTED OBJECTS BECAUSE IT WILL COPY THE REFERENCE OF THE NESTED OBJECTS INSTEAD OF COPYING THE VALUE OF THE NESTED OBJECTS. SO IF WE CHANGE THE VALUE OF THE NESTED OBJECTS IN obj4 THEN IT WILL ALSO CHANGE THE VALUE OF THE NESTED OBJECTS IN obj3 BECAUSE THEY ARE POINTING TO THE SAME REFERENCE.
const obj5={
    name:"bkk",
    age:20,
    city:"delhi",
    address:{
        street:"xyz",
        city:"abc"
    }
}
const obj6={...obj5};// it will return the object with all properties of obj5
obj6.address.street="pqr";
console.log(obj6);// it will return the object with all properties of obj5
console.log(obj5);// it will return the object with all properties of obj5 but the value of the property address.street will also change because they are pointing to the same reference.
// 
// this is a shallow copy of the object because it only copies the first level of the object and not the nested objects. so if we want to make a deep copy of the object then we can use JSON.parse() and JSON.stringify() methods.
const obj7=JSON.parse(JSON.stringify(obj5));// it will return the object with all properties of obj5
obj7.address.street="lmn";
console.log(obj7);// it will return the object with all properties of obj5
console.log(obj5);// it will return the object with all properties of obj5 but the value of the property address.street will not change because they are not pointing to the same reference.

// or we can use structuredClone() method to make a deep copy of the object.
const obj8=structuredClone(obj5);// it will return the object with all properties of obj5
obj8.address.street="stu";
console.log(obj8);// it will return the object with all properties of obj5
console.log(obj5);// it will return the object with all properties of obj5 but the value of the property address.street will not change because they are not pointing to the same reference.

// if we want to acces the symbol
const sym1=Symbol("hi");
const obj9={
    name:"bkk",
    age:20,
    city:"delhi",
    [sym1]:"hello"
}
console.log(obj9);// it will return the object with all properties of obj9 but the value of the property sym1 will not be visible because it is a symbol.
console.log(obj9[sym1]);// it will return the value of the property sym1 which is hello
