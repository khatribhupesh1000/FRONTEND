// objects

const obj1={
    name:"bkk",
    age:20,
    city:"delhi"    
}
console.log(obj1);// it will return the object with all properties

// to get the value of a particular property we can use dot notation or bracket notation
console.log(obj1.name);// it will return the value of the property name
console.log(obj1["age"]);// it will return the value of the property age

// to add a new property to the object we can use dot notation or bracket notation
obj1.country="india";
console.log(obj1);// it will return the object with all properties including the new property country

// to delete a property from the object we can use delete operator
delete obj1.city;
console.log(obj1);// it will return the object with all properties except the deleted property city

// to check whether a particular property is present in the object or not we can use in operator
console.log("name" in obj1);// it will return true if the property name is present in the object otherwise false
console.log("city" in obj1);// it will return false because city property is deleted from the object

// to get the keys of the object we can use Object.keys() method
console.log(Object.keys(obj1));// it will return an array of keys of the object

// to get the values of the object we can use Object.values() method
console.log(Object.values(obj1));// it will return an array of values of the object

// to get the entries of the object we can use Object.entries() method
console.log(Object.entries(obj1));// it will return an array of arrays with key value pairs of the object

