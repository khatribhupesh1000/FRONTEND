// ------------USE OF REST OPERATOR IN FUNCTION----------------
// it allows us to pass a variable number of arguments to a function and it will be stored in an array

function addNumber(...nums){
    let sum=0;
    for(let n of nums){
        sum+=n;
    }
    return sum;
}
addNumber(1,2,3,4,5);// it will return the sum of all numbers passed as arguments

// ------------rest and destructuring assignment----------------
const obj4={
    name:"skk",
    age:60,
    city:"hoshiarpur",
    occupation:"shop",
    greetings : function(){
        console.log(`hello ${this.name}`);// it will return the value of the property greetings which is a function and it will return hello
        return 8;
    }
}
const{name,city,...rest}=obj4;
console.log(name,city,rest);// it will return the value of the properties name and city and rest will be an object with all other properties of obj4 except name and city

// another example of rest and destructuring assignment in array
const array=[1,2,3,4,5];
const[x,y,z,...rest_num]=array;
console.log(x,y,z);// it will return the value of the elements of the array at index 0,2 and 4
console.log(...rest_num);// it will return the value of the elements of the array at index 1 and 3


