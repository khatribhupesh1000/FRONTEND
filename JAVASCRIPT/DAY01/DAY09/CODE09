// ---------------IIFE(Immediately Invoked Function Expression)---------------
(function(){
    console.log("hello world");
})();// it will return hello world

// WHERE TO USE IIFE-> it is used to create a private scope for the variables and 
// functions so that they are not accessible from outside the function. 
// It is also used to avoid polluting the global scope with variables and functions.
// It is also used to create a module pattern in JavaScript.

// CALLBACK FUNCTION-> it is a function that is passed as an argument to another function and
// it is executed after the completion of the function in which it is passed as an argument.
function greet(){
    console.log("hello world");//
}
function meet(callback){
    console.log("how are you?");// main function will execute first and then callback function will execute after the completion of main function
    callback();// it will return the value of the property greetings which is a function and it will return hello
    console.log("goodbye");// it will return goodbye
}
meet(greet);// it will return how are you? and hello world
    
