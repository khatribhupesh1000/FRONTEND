// similar filter comes into play -> it also take the call back function
let x=[];
let y=[];
arr.filter((a)=>{
    if(a>20) x.push(a);
    else y.push(a);
})
console.log(x,y);

// but filter also return the new array and in filter fuction we have to return something if not return then it will considered is false

const newArray=arr.filter((a)=>{
    console.log(a);
})
console.log(newArray);


const newArray2=arr.filter((a)=>{
    console.log(a);
    return a;
})
console.log(newArray2);

// custom filter method

let arr2=[100,78,23,45,12];
arr2.filtering=function(compare){
    const answer=[];
    for(let num of this){
        if(compare(num)){
            answer.push(num);
        }
    }
    return answer;
}
const r=arr2.filtering((a=>a>20));
console.log(r);
// to make it generalize use this

Array.prototype.sumFiltering=function(number){
   let sum=0;
   let difference=0;
   for(let num of this){
    if(number>0){
    sum+=num;
    }
    else{
        difference-=num;
    }
   }
   return number>0?sum:difference;
}

const newSum=arr2.sumFiltering(2);
console.log(newSum);

const sum1=arr.sumFiltering(0);
console.log(sum1);

